[node name="SuporteBR" type="MeshInstance3D" parent="Suportes"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 10, 0.25, -0.675)
mesh = SubResource("9")
surface_material_override/0 = SubResource("8")

; Rotação +90° em X: eixo local Y (height do CylinderMesh) alinha com mundo Z.
; Basis: X→(1,0,0)  Y→(0,0,1)  Z→(0,-1,0)
; Centro em Y=0.25 com raio=0.25 → top do rolete em Y=0.5
[node name="RoleteEsquerdo" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0, 1, 0, -1, 0, -10, 0.25, 0)
mesh = SubResource("7")
surface_material_override/0 = SubResource("6")

[node name="RoleteDireito" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0, 1, 0, -1, 0, 10, 0.25, 0)
mesh = SubResource("7")
surface_material_override/0 = SubResource("6")

; Centro em Y=0.475 → face superior em Y=0.5 (plano de apoio da tora).
; esteira.gd adiciona os sarrafos como filhos; em BOB o passo deles é
; compensado por γ para a superfície ficar em repouso com a tora
[node name="Correia" type="MeshInstance3D" parent="."]
