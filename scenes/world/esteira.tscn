[gd_scene load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/esteira.gd" id="1"]

; Gradient para a textura de listras da correia.
; Uma banda escura (#2A2A2A) de U=0.69 a U=0.81 por período de textura.
; Transição em 2 pontos (0.69→0.71 e 0.79→0.81) cria hard-edge de ~1px em 64px de largura.
[sub_resource type="Gradient" id="2"]
offsets = PackedFloat32Array(0.0, 0.69, 0.71, 0.79, 0.81, 1.0)
colors = PackedColorArray(0.22745, 0.22745, 0.22745, 1, 0.22745, 0.22745, 0.22745, 1, 0.16471, 0.16471, 0.16471, 1, 0.16471, 0.16471, 0.16471, 1, 0.22745, 0.22745, 0.22745, 1, 0.22745, 0.22745, 0.22745, 1)

; 64px suficientes para os 6 stops ficarem nítidos sem desperdício de VRAM
[sub_resource type="GradientTexture1D" id="3"]
gradient = SubResource("2")
width = 64

; Material da correia: cinza escuro #3A3A3A.
; albedo_color branco para que as cores do gradient apareçam sem tinting.
; uv1_scale.x=10 → 10 tiles de listra nos 20u do belt (1 listra visível a cada 2u).
; esteira.gd decrementa uv1_offset.x a cada frame → listras se deslocam em +X.
[sub_resource type="StandardMaterial3D" id="4"]
shading_mode = 2
albedo_color = Color(1, 1, 1, 1)
albedo_texture = SubResource("3")
roughness = 0.85
uv1_scale = Vector3(10.0, 1.0, 1.0)

; Correia: 20u × 0.05u (espessura) × 1.5u.
; Face superior em Y=0.5 → tora (raio=0.25) apoiada em Y=0.75.
[sub_resource type="BoxMesh" id="5"]
size = Vector3(20.0, 0.05, 1.5)

; Material dos roletes: cinza azulado metálico #6B7780
[sub_resource type="StandardMaterial3D" id="6"]
shading_mode = 2
albedo_color = Color(0.41961, 0.46667, 0.50196, 1)
metallic = 0.6
roughness = 0.4

; Rolete: raio=0.25, comprimento=1.5, deitado em Z via rotação +90° em X.
; Centro em Y=0.25 → top do rolete em Y=0.5, tangente à face inferior da correia.
[sub_resource type="CylinderMesh" id="7"]
top_radius = 0.25
bottom_radius = 0.25
height = 1.5
radial_segments = 8
rings = 1

; Material dos suportes: cinza azulado #4A5560
[sub_resource type="StandardMaterial3D" id="8"]
shading_mode = 2
albedo_color = Color(0.29020, 0.33333, 0.37647, 1)
metallic = 0.3

; Suporte: 0.15u × 0.5u (altura) × 0.15u — conecta os roletes ao chão (Y=0 → Y=0.5)
[sub_resource type="BoxMesh" id="9"]
size = Vector3(0.15, 0.5, 0.15)

; Pivot em Y=0 (nível do chão), centro geométrico em XZ
[node name="Esteira" type="Node3D"]
script = ExtResource("1")

[node name="Suportes" type="Node3D" parent="."]

; FL = Front (+Z) / Left (-X): canto traseiro-esquerdo da estrutura
; Y=0.25 = centro do suporte de altura 0.5 (de Y=0 a Y=0.5)
; Z=±0.675: borda interna da correia (belt width=1.5, edge at ±0.75, suporte 0.15 → centro a 0.675)
[node name="SuporteFL" type="MeshInstance3D" parent="Suportes"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -10, 0.25, 0.675)
mesh = SubResource("9")
surface_material_override/0 = SubResource("8")

[node name="SuporteFR" type="MeshInstance3D" parent="Suportes"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 10, 0.25, 0.675)
mesh = SubResource("9")
surface_material_override/0 = SubResource("8")

[node name="SuporteBL" type="MeshInstance3D" parent="Suportes"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -10, 0.25, -0.675)
mesh = SubResource("9")
surface_material_override/0 = SubResource("8")

[node name="SuporteBR" type="MeshInstance3D" parent="Suportes"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 10, 0.25, -0.675)
mesh = SubResource("9")
surface_material_override/0 = SubResource("8")

; Rotação +90° em X: eixo local Y (height do CylinderMesh) alinha com mundo Z.
; Basis: X→(1,0,0)  Y→(0,0,1)  Z→(0,-1,0)
; Centro em Y=0.25 com raio=0.25 → top do rolete em Y=0.5
[node name="RoleteEsquerdo" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0, 1, 0, -1, 0, -10, 0.25, 0)
mesh = SubResource("7")
surface_material_override/0 = SubResource("6")

[node name="RoleteDireito" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0, 1, 0, -1, 0, 10, 0.25, 0)
mesh = SubResource("7")
surface_material_override/0 = SubResource("6")

; Centro em Y=0.475 → face superior em Y=0.5 (plano de apoio da tora)
; UV scroll horizontal controlado por esteira.gd via uv1_offset.x
[node name="Correia" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.475, 0)
mesh = SubResource("5")
surface_material_override/0 = SubResource("4")
