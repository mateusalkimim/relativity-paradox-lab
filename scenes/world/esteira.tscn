[gd_scene load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/esteira.gd" id="1"]

; Material da correia: cinza escuro chapado. O movimento visível vem dos
; sarrafos físicos que esteira.gd cria como filhos da Correia — sem UV scroll.
[sub_resource type="StandardMaterial3D" id="4"]
shading_mode = 2
albedo_color = Color(0.22745, 0.22745, 0.22745, 1)
roughness = 0.85

; Correia: 20u × 0.05u (espessura) × 1.5u.
; Face superior em Y=0.5 → tora (raio=0.25) apoiada em Y=0.75.
[sub_resource type="BoxMesh" id="5"]
size = Vector3(20.0, 0.05, 1.5)

; Material dos roletes: cinza azulado #6B7780 — fosco (look LA Remake)
[sub_resource type="StandardMaterial3D" id="6"]
shading_mode = 2
albedo_color = Color(0.41961, 0.46667, 0.50196, 1)
metallic_specular = 0.15
roughness = 0.85

; Rolete: raio=0.25, comprimento=1.4 (< largura da correia 1.5 — rolo mais
; estreito evita z-fighting), deitado em Z via rotação +90° em X.
; Centro em Y=0.25 → top do rolete em Y=0.5, tangente à face inferior da correia.
[sub_resource type="CylinderMesh" id="7"]
top_radius = 0.25
bottom_radius = 0.25
height = 1.4
radial_segments = 8
rings = 1

; Material dos suportes: cinza azulado #4A5560 — fosco (look LA Remake)
[sub_resource type="StandardMaterial3D" id="8"]
shading_mode = 2
albedo_color = Color(0.29020, 0.33333, 0.37647, 1)
metallic_specular = 0.15
roughness = 0.9

; Suporte: 0.15u × 0.5u (altura) × 0.15u — conecta os roletes ao chão (Y=0 → Y=0.5)
[sub_resource type="BoxMesh" id="9"]
size = Vector3(0.15, 0.5, 0.15)

; Pivot em Y=0 (nível do chão), centro geométrico em XZ
[node name="Esteira" type="Node3D"]
script = ExtResource("1")

[node name="Suportes" type="Node3D" parent="."]

; FL = Front (+Z) / Left (-X): canto traseiro-esquerdo da estrutura
; Y=0.25 = centro do suporte de altura 0.5 (de Y=0 a Y=0.5)
; Z=±0.675: borda interna da correia (belt width=1.5, edge at ±0.75, suporte 0.15 → centro a 0.675)
[node name="SuporteFL" type="MeshInstance3D" parent="Suportes"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -10, 0.25, 0.675)
mesh = SubResource("9")
surface_material_override/0 = SubResource("8")

[node name="SuporteFR" type="MeshInstance3D" parent="Suportes"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 10, 0.25, 0.675)
mesh = SubResource("9")
surface_material_override/0 = SubResource("8")

[node name="SuporteBL" type="MeshInstance3D" parent="Suportes"]
